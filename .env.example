# Copy with `cp -n .env.example .env`, then supply your own credentials locally.
# Never commit .env.
# The framework reads process environment variables; it does not auto-load .env.
# OpenRouter supplies embeddings in the portable Anthropic/cascade examples.
OPENROUTER_API_KEY=
# Anthropic supplies chat, answers, navigation, and routing in those examples.
ANTHROPIC_API_KEY=
# Load explicitly for provider commands, e.g.
# uv run --frozen --env-file .env --extra vector --extra parse adaptive-rag ...
# Model requests require --allow-api and may incur charges.
